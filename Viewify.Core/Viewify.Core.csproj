<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Multi-target: net6.0 for the previous LTS (still widely used) and
         net8.0 for the current LTS release. net6.0 is the minimum because
         PriorityQueue<T,P> and Type.IsAssignableTo() are net5+/net6+ APIs. -->
    <TargetFrameworks>net6.0;net8.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Viewify.Base\Viewify.Base.csproj" />
  </ItemGroup>

</Project>
